// Copy these rules into Firebase Console > Firestore > Rules tab
// Then click "Publish"

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check user role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return request.auth != null && getUserRole() == 'admin';
    }

    function isAuthorOrAdmin() {
      return request.auth != null && (getUserRole() == 'admin' || getUserRole() == 'author');
    }

    function isLoggedIn() {
      return request.auth != null;
    }

    // Allow anyone to bump ONLY the engagement counters (views/likes/commentCount),
    // never a post's actual content.
    function isCounterUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['views', 'likes', 'commentCount']);
    }

    // USERS: anyone can read, only the user or admin can write
    match /users/{userId} {
      allow read: if true;
      allow create: if isLoggedIn() && request.auth.uid == userId;
      allow update: if isLoggedIn() && (request.auth.uid == userId || isAdmin());
    }

    // BLOG POSTS: anyone can read published, admin/author can write
    match /blogPosts/{postId} {
      allow read: if true;
      allow create: if isAuthorOrAdmin();
      allow update: if isAuthorOrAdmin() || isCounterUpdate();
      allow delete: if isAdmin();
    }

    // GROUPS: anyone can read, admin can create/delete, logged-in users can update (join/leave)
    match /groups/{groupId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isLoggedIn();
      allow delete: if isAdmin();
    }

    // GROUP POSTS: anyone can read, logged-in users can create, author or admin can delete
    match /groupPosts/{postId} {
      allow read: if true;
      allow create: if isLoggedIn();
      allow update: if isLoggedIn();
      allow delete: if isLoggedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // COMMENTS: anyone can read, logged-in users can create, author or admin can delete
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isLoggedIn();
      allow update: if isLoggedIn() && resource.data.authorId == request.auth.uid;
      allow delete: if isLoggedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }
  }
}
